{
  "textStyle": {
    "fontFamily": "Proxima Nova, sans-serif",
    "fontSize": 12,
    "fontWeight": "normal",
    "color": "#DDDDDD"
  },

  "axisLabel": {
    "fontSize": 12,
    "color": "#AAAAAA"
  },

  "legend": {
    "textStyle": {
      "fontSize": 12,
      "color": "#CCCCCC"
    },
    "orient": "horizontal",
    "top": "bottom"
  },

  "tooltip": {
    "textStyle": {
      "fontSize": 12,
      "color": "#FFFFFF"
    },
    "backgroundColor": "rgba(30, 30, 30, 0.85)",
    "borderColor": "#555555",
    "formatter": null
  },

  "backgroundColor": "#1e1e1e",

  "color": [
    "#fcc30b",
    "#0468b1",
    "#fd6925",
    "#c5192d",
    "#3f7e44",
    "#19486a",
    "#fd9d24",
    "#dd1367",
    "#4c9f38",
    "#0a97d9"
  ],

  "xAxis": {
    "axisLine": {
      "show": true,
      "lineStyle": {
        "color": "#888888",
        "type": "solid",
        "width": 1
      }
    },
    "splitLine": {
      "show": true,
      "lineStyle": {
        "type": "dashed",
        "color": "#444444",
        "opacity": 0.3
      }
    },
    "axisLabel": {
      "color": "#AAAAAA",
      "fontSize": 12
    },
    "nameTextStyle": {
      "color": "#CCCCCC",
      "fontSize": 14
    }
  },

  "yAxis": {
    "axisLine": {
      "show": true,
      "lineStyle": {
        "color": "#888888",
        "type": "solid",
        "width": 1
      }
    },
    "splitLine": {
      "show": true,
      "lineStyle": {
        "type": "dotted",
        "color": "#444444",
        "opacity": 0.3
      }
    },
    "axisLabel": {
      "color": "#AAAAAA",
      "fontSize": 12
    },
    "nameTextStyle": {
      "color": "#CCCCCC",
      "fontSize": 14
    }
  },

  "label": {
    "overflow": "truncate",
    "ellipsis": "..."
  },

  "hoverLayerThreshold": 3000,
  "tooltipTrigger": "axis",

  "emphasis": {
    "itemStyle": {
      "borderWidth": 1,
      "borderColor": "#FFFFFF"
    }
  },

  "accessibility": {
    "contrastRatioMin": 4.5,
    "colorBlindSafe": true
  }
}
