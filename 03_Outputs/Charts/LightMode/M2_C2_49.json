{
  "textStyle": {
    "fontFamily": "Proxima Nova, sans-serif",
    "fontSize": 12,
    "fontWeight": "normal"
  },
  "axisLabel": {
    "fontSize": 12,
    "color": "#666666"
  },
  "legend": {
    "textStyle": {
      "fontSize": 12,
      "color": "#444444"
    },
    "orient": "horizontal",
    "top": "bottom",
    "type": "scroll"
  },
  "tooltip": {
    "textStyle": {
      "fontSize": 12,
      "color": "#FFFFFF"
    },
    "backgroundColor": "rgba(50, 50, 50, 0.85)",
    "borderColor": "#CCCCCC",
    "formatter": null
  },
  "backgroundColor": "transparent",
  "color": [
    "#fcc30b",
    "#0468b1",
    "#fd6925",
    "#c5192d",
    "#3f7e44",
    "#19486a",
    "#fd9d24",
    "#dd1367",
    "#4c9f38",
    "#0a97d9"
  ],
  "xAxis": {
    "axisLine": {
      "show": true,
      "lineStyle": {
        "color": "#999999",
        "type": "solid",
        "width": 1
      }
    },
    "splitLine": {
      "show": true,
      "lineStyle": {
        "type": "dashed",
        "color": "#DDDDDD",
        "opacity": 0.5
      }
    },
    "axisLabel": {
      "color": "#666666",
      "fontSize": 12,
      "interval": 0
    },
    "nameTextStyle": {
      "color": "#444444",
      "fontSize": 14
