    "type": "category",
    "data": [
      "World",
      "Central and Southern\nAsia",
      "Eastern and South\neastern Asia",
      "Sub-Saharan Africa",
      "Western Asia and\nNorthern Africa"
    ],
    "name": "Region"
  },
  "yAxis": {
    "axisLine": {
      "show": true,
      "lineStyle": {
        "color": "#999999",
        "type": "solid",
        "width": 1
      }
    },
    "splitLine": {
      "show": true,
      "lineStyle": {
        "type": "dotted",
        "color": "#EEEEEE",
        "opacity": 0.4
      }
    },
    "axisLabel": {
      "color": "#666666",
      "fontSize": 12
    },
    "nameTextStyle": {
      "color": "#444444",
      "fontSize": 14
    },
    "type": "value",
    "name": "Population (millions)"
  },
  "label": {
    "overflow": "truncate",
    "ellipsis": "..."
