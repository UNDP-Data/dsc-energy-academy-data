    "data": [
      2010,
      2020,
      2022
    ],
    "name": "Year"
  },
  "yAxis": {
    "axisLine": {
      "show": true,
      "lineStyle": {
        "color": "#999999",
        "type": "solid",
        "width": 1
      }
    },
    "splitLine": {
      "show": true,
      "lineStyle": {
        "type": "dotted",
        "color": "#EEEEEE",
        "opacity": 0.4
      }
    },
    "axisLabel": {
      "color": "#666666",
      "fontSize": 12
    },
    "nameTextStyle": {
      "color": "#444444",
      "fontSize": 14
    },
    "type": "value",
    "name": "Share of population with access to electricity"
  },
  "label": {
    "overflow": "truncate",
    "ellipsis": "..."
  },
  "hoverLayerThreshold": 3000,
  "tooltipTrigger": "axis",
  "emphasis": {
    "itemStyle": {
      "borderWidth": 1,
      "borderColor": "#000000"
    }
  },
  "accessibility": {
    "contrastRatioMin": 4.5,
    "colorBlindSafe": true
