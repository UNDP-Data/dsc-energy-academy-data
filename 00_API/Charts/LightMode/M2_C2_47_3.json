  "xAxis": {
    "axisLine": {
      "show": true,
      "lineStyle": {
        "color": "#999999",
        "type": "solid",
        "width": 1
      }
    },
    "splitLine": {
      "show": true,
      "lineStyle": {
        "type": "dashed",
        "color": "#DDDDDD",
        "opacity": 0.5
      }
    },
    "axisLabel": {
      "color": "#666666",
      "fontSize": 12
    },
    "nameTextStyle": {
      "color": "#444444",
      "fontSize": 14
