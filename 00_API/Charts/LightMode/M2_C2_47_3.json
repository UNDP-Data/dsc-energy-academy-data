{
  "textStyle": {
    "fontFamily": "Proxima Nova, sans-serif",
    "fontSize": 12,
    "fontWeight": "normal"
  },
  "axisLabel": {
    "fontSize": 12,
    "color": "#666666"
  },
  "legend": {
    "textStyle": {
      "fontSize": 12,
      "color": "#444444"
    },
    "orient": "horizontal",
    "top": "bottom",
    "type": "scroll"
  },
  "tooltip": {
    "textStyle": {
      "fontSize": 12,
      "color": "#FFFFFF"
    },
    "backgroundColor": "rgba(50, 50, 50, 0.85)",
    "borderColor": "#CCCCCC",
    "formatter": null
  },
  "backgroundColor": "transparent",
  "color": [
    "#fcc30b",
    "#0468b1",
    "#fd6925",
    "#c5192d",
    "#3f7e44",
    "#19486a",
    "#fd9d24",
    "#dd1367",
    "#4c9f38",
    "#0a97d9"
