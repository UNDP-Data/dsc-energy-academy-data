{
  "textStyle": {
    "fontFamily": "Proxima Nova, sans-serif",
    "fontSize": 12,
    "fontWeight": "normal"
  },
  "axisLabel": {
    "fontSize": 12,
    "color": "#666666"
  },
  "legend": {
    "textStyle": {
      "fontSize": 12,
      "color": "#444444"
    },
    "orient": "horizontal",
    "top": "bottom",
    "type": "scroll"
  },
  "tooltip": {
    "textStyle": {
      "fontSize": 12,
      "color": "#FFFFFF"
    },
    "backgroundColor": "rgba(50, 50, 50, 0.85)",
    "borderColor": "#CCCCCC",
    "formatter": null
  },
  "backgroundColor": "transparent",
  "color": [
    "#fcc30b",
    "#0468b1",
    "#fd6925",
    "#c5192d",
    "#3f7e44",
    "#19486a",
    "#fd9d24",
    "#dd1367",
    "#4c9f38",
    "#0a97d9"
  ],
  "xAxis": {
    "axisLine": {
      "show": true,
      "lineStyle": {
        "color": "#999999",
        "type": "solid",
        "width": 1
      }
    },
    "splitLine": {
      "show": true,
      "lineStyle": {
        "type": "dashed",
        "color": "#DDDDDD",
        "opacity": 0.5
      }
    },
    "axisLabel": {
      "color": "#666666",
      "fontSize": 12,
      "interval": 0
    },
    "nameTextStyle": {
      "color": "#444444",
      "fontSize": 14
    },
    "type": "category",
    "data": [
      "Low Demand",
      "Bottom-Up",
      "High Demand"
    ],
    "name": "Scenario"
  },
  "yAxis": {
    "axisLine": {
      "show": true,
      "lineStyle": {
        "color": "#999999",
        "type": "solid",
        "width": 1
      }
    },
    "splitLine": {
      "show": true,
      "lineStyle": {
        "type": "dotted",
        "color": "#EEEEEE",
        "opacity": 0.4
      }
    },
    "axisLabel": {
      "color": "#666666",
      "fontSize": 12
    },
    "nameTextStyle": {
      "color": "#444444",
      "fontSize": 14
    },
    "type": "value",
    "name": "USD billions"
  },
  "label": {
    "overflow": "truncate",
    "ellipsis": "..."
  },
  "hoverLayerThreshold": 3000,
  "tooltipTrigger": "axis",
  "emphasis": {
    "itemStyle": {
      "borderWidth": 1,
      "borderColor": "#000000"
    }
  },
  "accessibility": {
    "contrastRatioMin": 4.5,
    "colorBlindSafe": true
  },
  "series": [
    {
      "name": "Grid (USD bn)",
      "type": "bar",
      "data": [
        115,
        120,
        140
      ]
    },
    {
      "name": "Mini-grid (USD bn)",
      "type": "bar",
      "data": [
        5,
        15,
        40
      ]
    },
    {
      "name": "Stand-alone (USD bn)",
      "type": "bar",
      "data": [
        35,
        40,
        75
      ]
    },
    {
      "name": "Total (USD bn)",
      "type": "bar",
      "data": [
        155,
        175,
        255
      ]
    }
  ],
  "grid": {
    "bottom": 40
